# ==============================================================================
# JobPlatform Global - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the platform:
#   cp .env.example .env
#
# IMPORTANT: In production, NEVER commit the .env file with real secrets to version control.
# ==============================================================================

# Node Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# HTTP Server Port (Default: 5050)
PORT=5050

# Cryptographically Secure JWT Secret Key (MANDATORY in production, minimum 32 chars)
# Generate one using: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_string_min_32_characters_long

# Allowed CORS Origins (comma-separated list for production)
# In production, set to your actual domain(s), e.g. https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5050,http://127.0.0.1:5050

# Demo Role Switcher Flag (Set to 'false' in production to disable 1-click test credentials)
# In production, this MUST be set to false.
ENABLE_DEMO_LOGIN=true

# SQLite Database Storage File Path (Defaults to ./jobplatform.sqlite)
DB_PATH=./jobplatform.sqlite

# ==============================================================================
# Stripe Payment Gateway Configuration (For Real Platform Commission Processing)
# ==============================================================================
# 1. Sign up at https://stripe.com
# 2. Get API keys from Dashboard -> Developers -> API Keys
# 3. For Webhooks: Dashboard -> Developers -> Webhooks -> Add endpoint:
#    Endpoint URL: https://yourdomain.com/api/payments/webhook
#    Events to listen for: payment_intent.succeeded, payment_intent.payment_failed

# Stripe Secret API Key (starts with sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=

# Stripe Webhook Signing Secret (starts with whsec_...)
STRIPE_WEBHOOK_SECRET=

# Public Stripe Publishable Key (for frontend card element, starts with pk_test_... or pk_live_...)
STRIPE_PUBLISHABLE_KEY=

# ==============================================================================
# Initial Platform Super Administrator (Optional for npm run create-admin)
# ==============================================================================
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
